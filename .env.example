# --------------------------------------------------------------------------
# AI Digital Product Factory — environment variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.
# --------------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Phase 2)
# From your project's Settings -> API page. New projects show a
# "Publishable key" (sb_publishable_...) and "Secret key" (sb_secret_...);
# older projects may instead show a legacy "anon" / "service_role" JWT —
# either format works, the app reads whichever pair is set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy key names (still supported as a fallback if that's what your
# project shows instead of the pair above):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Phase 11) — TEST MODE ONLY. A server-side guard (see
# src/lib/stripe/stripe-env.ts) rejects any key that isn't clearly
# test-mode (sk_test_.../rk_test_...) — a live-mode key here simply won't
# work, by design. Get these from https://dashboard.stripe.com/test/apikeys
# and https://dashboard.stripe.com/test/webhooks (with "Test mode" toggled
# on in the Stripe Dashboard).
STRIPE_SECRET_KEY=
# Only needed if a future page ever uses Stripe.js/Elements directly in
# the browser (e.g. a custom card element) — this app currently uses only
# server-created, Stripe-hosted Checkout/Billing Portal sessions, which
# need no publishable key at all. Leave unset unless you add such a page.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe test-mode Price IDs (Phase 11) — one per paid plan in
# src/config/plans.ts. Create a TEST MODE Product + Price for each plan in
# the Stripe Dashboard (Test mode -> Product catalog) and paste the
# resulting price_... id here. A plan with no price configured here is
# shown but disabled ("Not configured") on the Billing page — never
# invented or hard-coded in application code.
STRIPE_STARTER_PRICE_ID=
STRIPE_CREATOR_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# AI image generation (Phase 5/6) — abstracted behind /lib/ai/*, selected
# server-side only. Never NEXT_PUBLIC_* — these are never sent to the browser.
# AI_IMAGE_PROVIDER=mock          # default; no credentials needed
# AI_IMAGE_PROVIDER=openai        # requires OPENAI_API_KEY below
AI_IMAGE_PROVIDER=mock
OPENAI_API_KEY=
# Max simultaneous provider requests during one generation job (default 2,
# capped at 5 regardless of this value). Keep conservative for real providers.
AI_GENERATION_CONCURRENCY=2

# Vectorization (Phase 7) — abstracted behind /lib/vector/*, selected
# server-side only. Never NEXT_PUBLIC_* — no real vector API key exists
# yet; only the mock/local provider is implemented so far.
# VECTOR_PROVIDER=mock          # default; no credentials needed
VECTOR_PROVIDER=mock
VECTOR_API_KEY=

# Mockup generation (Phase 8) — abstracted behind /lib/mockups/*, selected
# server-side only. Never NEXT_PUBLIC_* — no real mockup provider is
# implemented yet; only the deterministic mock/local provider exists so far.
# MOCKUP_PROVIDER=mock          # default; no credentials needed
MOCKUP_PROVIDER=mock
MOCKUP_API_KEY=
# Max simultaneous provider requests during one mockup generation batch
# (default 2, capped at 5 regardless of this value). Keep conservative for
# real providers.
MOCKUP_GENERATION_CONCURRENCY=2

# Listing text generation (Phase 9) — abstracted behind /lib/ai/text-provider*,
# selected server-side only. Never NEXT_PUBLIC_* — no real LLM text provider
# is implemented yet; only the deterministic mock/local provider exists so far.
# AI_TEXT_PROVIDER=mock          # default; no credentials needed
AI_TEXT_PROVIDER=mock
