# --------------------------------------------------------------------------
# AI Digital Product Factory — environment variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.
# --------------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Phase 2)
# From your project's Settings -> API page. New projects show a
# "Publishable key" (sb_publishable_...) and "Secret key" (sb_secret_...);
# older projects may instead show a legacy "anon" / "service_role" JWT —
# either format works, the app reads whichever pair is set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy key names (still supported as a fallback if that's what your
# project shows instead of the pair above):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Phase 11)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# AI image generation (Phase 5/6) — abstracted behind /lib/ai/*, selected
# server-side only. Never NEXT_PUBLIC_* — these are never sent to the browser.
# AI_IMAGE_PROVIDER=mock          # default; no credentials needed
# AI_IMAGE_PROVIDER=openai        # requires OPENAI_API_KEY below
AI_IMAGE_PROVIDER=mock
OPENAI_API_KEY=
# Max simultaneous provider requests during one generation job (default 2,
# capped at 5 regardless of this value). Keep conservative for real providers.
AI_GENERATION_CONCURRENCY=2

# Vectorization (Phase 7) — abstracted behind /lib/vector/*, selected
# server-side only. Never NEXT_PUBLIC_* — no real vector API key exists
# yet; only the mock/local provider is implemented so far.
# VECTOR_PROVIDER=mock          # default; no credentials needed
VECTOR_PROVIDER=mock
VECTOR_API_KEY=

# Other future AI providers (Phase 8+) — abstracted behind /lib/mockups
MOCKUP_API_KEY=
