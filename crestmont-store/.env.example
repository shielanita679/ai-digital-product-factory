# Copy to .env.local (development) or set in your host's environment settings.
# Never commit real values. Only variables prefixed NEXT_PUBLIC_ are exposed to
# the browser — none of those may contain a secret.

# Public site origin, no trailing slash. Used for canonical URLs, sitemap,
# structured data and the support email domain. Example format: https://www.your-domain.com
NEXT_PUBLIC_SITE_URL=

# Stripe (server-side only). Use test-mode keys until you are ready to go live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to "true" only after Stripe Tax is activated in your Stripe dashboard.
STRIPE_AUTOMATIC_TAX=false

# Contact / order-status form delivery (optional, pick one).
# Resend (https://resend.com): API key + a verified "from" address on your domain.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
# Or: a webhook endpoint that receives JSON form submissions (e.g. a helpdesk).
CONTACT_WEBHOOK_URL=

# Newsletter signups (optional): webhook endpoint for your email-marketing tool.
NEWSLETTER_WEBHOOK_URL=
