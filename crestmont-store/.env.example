# CRESTMONT HOLDINGS store — environment variables.
# Copy to .env.local (development) or set in your host's environment settings.
# Never commit real values. Only NEXT_PUBLIC_* variables reach the browser, and
# none of those may contain a secret.
#
# Every value here must belong to THIS store. Do not reuse credentials from any
# other application in this repository.

# Production origin, no trailing slash, e.g. https://www.<your-domain>
# Set at BUILD time: it feeds canonical URLs, the sitemap and structured data.
NEXT_PUBLIC_SITE_URL=

# Real, monitored customer-support inbox (shown on the site, receives form
# messages). Set at BUILD time.
SUPPORT_EMAIL=

# Stripe — Crestmont's own account, server-side only. Payments also stay off
# until commerce.paymentsEnabled is set to true in src/config/commerce.ts.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Keep "false" until Stripe Tax is configured and tax setup is finalized.
STRIPE_AUTOMATIC_TAX=false

# Contact / order-status form delivery via Resend (https://resend.com).
# Forms show as unavailable until RESEND_API_KEY, CONTACT_FROM_EMAIL and
# SUPPORT_EMAIL are all set. CONTACT_FROM_EMAIL must be verified in Resend.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
