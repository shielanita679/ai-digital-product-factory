# --------------------------------------------------------------------------
# AI Digital Product Factory — environment variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.
# --------------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Phase 2)
# From your project's Settings -> API page. New projects show a
# "Publishable key" (sb_publishable_...) and "Secret key" (sb_secret_...);
# older projects may instead show a legacy "anon" / "service_role" JWT —
# either format works, the app reads whichever pair is set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy key names (still supported as a fallback if that's what your
# project shows instead of the pair above):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Phase 11)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# AI providers (Phase 5+) — abstracted behind /lib/ai, /lib/vector, /lib/mockups
AI_TEXT_API_KEY=
AI_IMAGE_API_KEY=
VECTOR_API_KEY=
MOCKUP_API_KEY=
